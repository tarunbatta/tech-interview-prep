{
  "name": "tech-interview-prep",
  "version": "1.0.0",
  "description": "Tech & Engineering Management Interview Preparation Guide — Data Structures, Algorithms, System Design, and Leadership",
  "scripts": {
    "build": "dotnet build",
    "build:dotnet": "dotnet build",
    "build:leetcode": "dotnet build src/leetcode/csharp",
    "build:chess": "dotnet build apps/chess-game",
    "build:expression-tree": "dotnet build apps/expression-tree",
    "start:chess": "dotnet run --project apps/chess-game",
    "start:expression-tree": "dotnet run --project apps/expression-tree",
    "start:leetcode-scraper": "node apps/leetcode-scraper/index.js",
    "test:leetcode-scraper": "npm --prefix apps/leetcode-scraper test",
    "lint:leetcode-scraper": "npm --prefix apps/leetcode-scraper run lint",
    "start:dotnet": "dotnet run --project src/leetcode/csharp",
    "start:dotnet-core": "dotnet run --project src/leetcode/csharp",
    "start:js": "node src/qotd/javascript/SuperArray.js",
    "create-system-design": "./scripts/create-system-design.sh",
    "lint:md": "npx markdownlint-cli2 '**/*.md'",
    "lint:md:fix": "npx markdownlint-cli2 --fix '**/*.md'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarunbatta/tech-interview-prep.git"
  },
