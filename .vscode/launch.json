{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch: Core",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/dotnet/core/bin/Debug/net10.0/core.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/dotnet/core",
            "console": "internalConsole",
            "stopAtEntry": false,
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": ".NET Launch: Chess Game",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-chess",
            "program": "${workspaceFolder}/apps/chess-game/bin/Debug/net10.0/ChessGame.dll",
            "args": [],
            "cwd": "${workspaceFolder}/apps/chess-game",
            "console": "internalConsole",
            "stopAtEntry": false,
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": ".NET Launch: Expression Tree",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-expression-tree",
            "program": "${workspaceFolder}/apps/expression-tree/bin/Debug/net10.0/ExpressionTree.dll",
            "args": [],
            "cwd": "${workspaceFolder}/apps/expression-tree",
            "console": "internalConsole",
            "stopAtEntry": false,
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": ".NET Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}