{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/tech-interview-prep.sln"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build-leetcode",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/leetcode/csharp/LeetCode.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-chess",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/apps/chess-game/ChessGame.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-expression-tree",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/apps/expression-tree/ExpressionTree.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
